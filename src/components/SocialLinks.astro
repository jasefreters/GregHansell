---
import { SITE } from '../site.config';

const links = SITE.socials.filter((s) => s.url);
---
{links.length > 0 && (
  <ul class="socials">
    {links.map((s) => (
      <li><a href={s.url} rel="me noopener" target="_blank">{s.label}<span class="visually-hidden"> (opens in a new tab)</span></a></li>
    ))}
  </ul>
)}

<style>
  .socials { display: flex; flex-wrap: wrap; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
</style>
