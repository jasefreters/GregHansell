---
/**
 * An artwork photo at its true proportions (never cropped).
 * Pass `decorative` when a caption next to it already names the work
 * (e.g. inside a linked card), so screen readers don't hear it twice.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  decorative?: boolean;
  priority?: boolean;
  class?: string;
}
const { image, alt, sizes, decorative = false, priority = false, class: className } = Astro.props;
---
<Image
  src={image}
  alt={decorative ? '' : alt}
  widths={[480, 800, 1200, 1600, 2000].filter((w) => w <= image.width)}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  class:list={['artwork', className]}
/>

<style>
  .artwork {
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-art);
    background: var(--color-surface);
  }
</style>
