---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'exhibitions'>[];
}
const { items } = Astro.props;
const rendered = await Promise.all(items.map(async (item) => ({ item, ...(await render(item)) })));

const fmt = (d: Date, withYear: boolean) =>
  d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', ...(withYear && { year: 'numeric' }), timeZone: 'UTC' });

function dates(date?: Date, endDate?: Date) {
  if (!date) return undefined;
  if (!endDate) return fmt(date, true);
  const sameYear = date.getUTCFullYear() === endDate.getUTCFullYear();
  return `${fmt(date, !sameYear)} – ${fmt(endDate, true)}`;
}
---
<ol class="timeline">
  {rendered.map(({ item, Content }) => {
    const { title, venue, year, date, endDate, link } = item.data;
    const shownYear = date?.getUTCFullYear() ?? year;
    const details = [venue, dates(date, endDate)].filter(Boolean).join(' · ');
    return (
      <li class="timeline__item">
        <p class="timeline__year meta">{shownYear ?? ''}</p>
        <div>
          <h3 class="timeline__title">{link ? <a href={link}>{title}</a> : title}</h3>
          {details && <p class="timeline__details meta">{details}</p>}
          {item.body?.trim() && <div class="timeline__body"><Content /></div>}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .timeline { list-style: none; margin: 0; padding: 0; }
  .timeline__item {
    display: grid;
    gap: 0 var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 40rem) {
    .timeline__item { grid-template-columns: 5rem 1fr; }
  }
  .timeline__year { margin: 0 0 var(--space-1); font-size: 1.15rem; color: var(--color-text); }
  .timeline__title { margin: 0; }
  .timeline__details { margin: var(--space-1) 0 0; }
  .timeline__body { margin-top: var(--space-2); max-width: var(--measure); }
  .timeline__body :global(p:last-child) { margin-bottom: 0; }
</style>
