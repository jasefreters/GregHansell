---
import { NAV, SITE } from '../site.config';
import { url, isCurrent } from '../utils';

const pathname = Astro.url.pathname;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={url('/')}>
      <span class="brand__name">{SITE.name}</span>
      <span class="brand__tagline">{SITE.tagline}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {NAV.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isCurrent(item.href, pathname) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--color-border); }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-3) var(--space-2);
  }
  @media (min-width: 48rem) {
    .site-header__inner { padding-block: var(--space-4); }
  }
  .brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
    text-decoration: none;
    color: var(--color-text);
  }
  .brand:hover { color: var(--color-text); }
  .brand__name { font-size: 1.6rem; line-height: 1.2; letter-spacing: -0.01em; }
  .brand__tagline { font-size: 0.95rem; color: var(--color-muted); font-style: italic; }
  @media (max-width: 40rem) {
    .brand__tagline { display: none; }
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    list-style: none;
    margin: 0 0 0 calc(-1 * var(--space-1));
    padding: 0;
  }
  @media (max-width: 40rem) {
    .nav { gap: 0 var(--space-2); }
    .nav a { font-size: 1rem; padding-inline: var(--space-1); }
  }
  .nav a {
    display: inline-block;
    padding: var(--space-2) var(--space-1);
    font-size: 1.05rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .nav a:hover { color: var(--color-accent); }
  .nav a[aria-current='page'] {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }
</style>
