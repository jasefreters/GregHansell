---
import type { CollectionEntry } from 'astro:content';
import ArtworkCard from './ArtworkCard.astro';

interface Props {
  works: CollectionEntry<'works'>[];
  headingLevel?: 'h2' | 'h3';
}
const { works, headingLevel } = Astro.props;
---
<ul class="grid">
  {works.map((work) => (
    <li><ArtworkCard work={work} headingLevel={headingLevel} /></li>
  ))}
</ul>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-6) var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
