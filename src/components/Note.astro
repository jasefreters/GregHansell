---
/**
 * A clearly marked editor's note. Use it for placeholder text or for
 * details that still need checking. Delete the <Note> once the real
 * content is in.
 *
 *   <Note>Add Greg's artist statement here.</Note>
 *   <Note kind="check">Drafted from public sources — check against the book.</Note>
 */
interface Props {
  kind?: 'placeholder' | 'check';
}
const { kind = 'placeholder' } = Astro.props;
const label = kind === 'check' ? 'To check' : 'Placeholder';
---
<aside class="note" data-kind={kind}>
  <strong class="note__label">{label}:</strong>
  <slot />
</aside>

<style>
  .note {
    max-width: var(--measure);
    margin: var(--space-3) 0;
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-note-border);
    border-radius: var(--radius);
    background: var(--color-note-bg);
    font-size: 0.95rem;
  }
  .note__label {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
    margin-right: var(--space-1);
  }
  .note :global(p:last-child) { margin-bottom: 0; }
</style>
