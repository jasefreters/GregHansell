---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE } from '../site.config';
import { url } from '../utils';

const hasSocials = SITE.socials.some((s) => s.url);
---
<BaseLayout title="Contact" description="How to enquire about Greg Hansell's paintings, exhibitions and book.">
  <div class="container section">
    <div class="prose">
      <h1>Contact</h1>

      {SITE.gallery.url && (
        <section>
          <h2>Available works</h2>
          <p>
            Greg's paintings are shown and sold by <a href={SITE.gallery.url}>{SITE.gallery.name}</a>,
            {SITE.gallery.place}. Contact the gallery about available works and prices.
          </p>
        </section>
      )}

      {SITE.email && (
        <section>
          <h2>Exhibitions and other enquiries</h2>
          <p>Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
        </section>
      )}

      <section>
        <h2>The book</h2>
        <p>
          <a href={url('/book/')}><cite>Greg Hansell: Purity of Australian Light</cite></a> is
          published by <a href="https://www.beaglepress.com.au/">The Beagle Press</a> and
          available from booksellers.
        </p>
      </section>

      {hasSocials && (
        <section>
          <h2>Follow</h2>
          <SocialLinks />
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  section + section { margin-top: var(--space-5); }
  h1 { margin-bottom: var(--space-5); }
  h2 { font-size: 1.6rem; }
</style>
