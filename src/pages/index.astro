---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkGrid from '../components/ArtworkGrid.astro';
import { getWorks } from '../collections';
import { SITE } from '../site.config';
import { url } from '../utils';

const featured = (await getWorks()).filter((w) => w.data.featured).slice(0, 6);
---
<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">Australian artist · Hawkesbury, NSW</p>
      <h1>{SITE.name}</h1>
      <p class="lede">
        Pastel paintings of weathered iron, timber and old machinery, and the Australian light
        that falls across them.
      </p>
      <p class="hero__actions">
        <a class="button" href={url('/works/')}>See the work</a>
        <a class="button button--ghost" href={url('/about/')}>About Greg</a>
      </p>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section">
      <div class="container">
        <h2>Selected works</h2>
        <ArtworkGrid works={featured} />
        <p class="more"><a href={url('/works/')}>All works →</a></p>
      </div>
    </section>
  )}

  <section class="section book-teaser">
    <div class="container book-teaser__inner">
      <div>
        <p class="eyebrow">The book</p>
        <h2>Greg Hansell: Purity of Australian Light</h2>
        <p>A monograph on Greg's pastels by Lou Klepac, published by The Beagle Press in 2024.</p>
        <a href={url('/book/')}>About the book →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-6);
    background:
      linear-gradient(180deg, transparent, var(--color-bg)),
      repeating-linear-gradient(90deg,
        color-mix(in srgb, var(--color-iron) 10%, var(--color-bg)) 0 9px,
        var(--color-bg) 9px 18px);
    border-bottom: 1px solid var(--color-border);
  }
  .hero h1 { font-size: clamp(2.6rem, 1.6rem + 5vw, 5rem); margin-bottom: var(--space-3); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .more { margin-top: var(--space-4); }
  .book-teaser { background: var(--color-surface); border-block: 1px solid var(--color-border); }
  .book-teaser__inner > div { max-width: var(--measure); }
</style>
