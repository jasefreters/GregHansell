---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExhibitionList from '../components/ExhibitionList.astro';
import { getExhibitions } from '../collections';

const items = await getExhibitions();
const groups = [
  { heading: 'Exhibitions and events', items: items.filter((i) => ['Exhibition', 'Event'].includes(i.data.kind)) },
  { heading: 'Prizes and honours', items: items.filter((i) => ['Prize', 'Award'].includes(i.data.kind)) },
].filter((g) => g.items.length);
---
<BaseLayout title="Exhibitions" description="Exhibitions, prizes and honours of Australian painter Greg Hansell.">
  <div class="container section">
    <header class="page-head">
      <h1>Exhibitions</h1>
      <p class="lede">A selection of exhibitions, prizes and honours.</p>
    </header>
    {groups.map((g) => (
      <section class="group">
        <h2>{g.heading}</h2>
        <ExhibitionList items={g.items} />
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .group + .group { margin-top: var(--space-6); }
  .group { max-width: 52rem; }
</style>
