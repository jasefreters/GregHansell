---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkGrid from '../../components/ArtworkGrid.astro';
import { getWorks } from '../../collections';
import { url } from '../../utils';

const works = await getWorks();
const pictured = works.filter((w) => w.data.image);
const unpictured = works.filter((w) => !w.data.image);
---
<BaseLayout title="Works" description="Paintings by Greg Hansell in earth pastel and oil.">
  <div class="container section">
    <header class="page-head">
      <h1>Works</h1>
      <p class="lede">Landscapes, still lifes and studies of the Hawkesbury, in earth pastel and oil.</p>
    </header>
    <ArtworkGrid works={pictured} headingLevel="h2" />

    {unpictured.length > 0 && (
      <section class="other">
        <h2>Also in the record</h2>
        <ul>
          {unpictured.map((w) => (
            <li>
              <a href={url(`/works/${w.id}/`)}>{w.data.title}</a>
              {w.data.year && <span class="meta">, {w.data.year}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .other { margin-top: var(--space-7); max-width: var(--measure); }
  .other ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  .other li { padding-block: var(--space-2); border-bottom: 1px solid var(--color-border); }
  .other a { display: inline-block; padding-block: var(--space-1); }
</style>
