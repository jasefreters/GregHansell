---
import BaseLayout from '../layouts/BaseLayout.astro';
import Note from '../components/Note.astro';
---
<BaseLayout
  title="Book"
  description="Greg Hansell: Purity of Australian Light, a monograph by Lou Klepac published by The Beagle Press."
  type="article"
>
  <div class="container section">
    <article class="prose">
      <p class="eyebrow">The book</p>
      <h1>Greg Hansell: Purity of Australian Light</h1>
      <Note>Add a photo of the book cover here.</Note>

      <p class="lede">
        A monograph on Greg's pastels by Lou Klepac, covering his work from 1982 onwards.
      </p>

      <dl class="facts">
        <dt>Author</dt><dd>Lou Klepac</dd>
        <dt>Publisher</dt><dd><a href="https://www.beaglepress.com.au/">The Beagle Press</a></dd>
        <dt>Published</dt><dd>2024</dd>
        <dt>ISBN</dt><dd>978-0-947349-70-7</dd>
      </dl>

      <p>
        The book was launched at Hawkesbury Central Library on 13 April 2024.
      </p>

      <Note>Add a short description of the book and where to buy a copy.</Note>
    </article>
  </div>
</BaseLayout>

<style>
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-3) 0;
    border-block: 1px solid var(--color-border);
    margin: var(--space-4) 0;
  }
  .facts dt { color: var(--color-muted); }
  .facts dd { margin: 0; }
</style>
