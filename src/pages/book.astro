---
import BaseLayout from '../layouts/BaseLayout.astro';
import Artwork from '../components/Artwork.astro';
import bookCover from '../assets/book-cover.jpg';
---
<BaseLayout
  title="Book"
  description="Greg Hansell: Purity of Australian Light, a 192-page monograph by Lou Klepac published by The Beagle Press in 2024."
  image={bookCover.src}
  type="article"
>
  <div class="container section book">
    <div class="book__cover">
      <Artwork image={bookCover} alt="Book cover: a painting of a corrugated-iron shed with an open window, titled Greg Hansell." sizes="(min-width: 48rem) 24rem, 80vw" priority />
    </div>
    <article class="prose">
      <h1>Greg Hansell: Purity of Australian Light</h1>
      <p class="lede">
        The first book on Greg's work, tracing more than forty years of painting from 1982 to
        the present day.
      </p>
      <p>
        The works were selected by Lou Klepac, who also wrote the introduction. The book includes
        an essay by Carol Roberts, and recollections and notes by the artist.
      </p>

      <dl class="facts">
        <dt>Author</dt><dd>Lou Klepac</dd>
        <dt>Publisher</dt><dd><a href="https://www.beaglepress.com.au/">The Beagle Press</a></dd>
        <dt>Published</dt><dd>2024</dd>
        <dt>Format</dt><dd>Hardcover, 192 pages, colour illustrations</dd>
        <dt>ISBN</dt><dd>978-0-947349-70-7</dd>
      </dl>

      <p>
        The book was launched at Hawkesbury Central Library on 13 April 2024. Copies are
        available from booksellers including the
        <a href="https://qagoma.store/products/greg-hansell-purity-of-australian-light">QAGOMA Store</a>.
      </p>
    </article>
  </div>
</BaseLayout>

<style>
  .book { display: grid; gap: var(--space-5); align-items: start; }
  @media (min-width: 48rem) {
    .book { grid-template-columns: minmax(14rem, 24rem) minmax(0, 1fr); gap: var(--space-6); }
  }
  .book__cover { max-width: 24rem; }
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-3);
    border-block: 1px solid var(--color-border);
    margin: var(--space-4) 0;
    font-size: 1.05rem;
  }
  .facts dt { color: var(--color-muted); }
  .facts dd { margin: 0; font-variant-numeric: lining-nums; }
</style>
